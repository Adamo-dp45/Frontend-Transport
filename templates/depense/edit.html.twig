{% extends 'base.html.twig' %}

{% block title %}Modifier la dépense{% endblock %}

{% block body %}
<div class="flex items-center gap-3 mb-4">
    <a href="{{ path('depense.show', {id: depense.id}) }}" class="btn-icon">
        <svg class="h-5 w-5" aria-hidden="true" width="14" height="14">
            <use href="{{ asset('sprite.svg') }}#chevron-left"></use>
        </svg>
    </a>
    <div>
        <h1 class="text-3xl font-light tracking-[-0.55px] leading-[1.2]">Modifier la dépense</h1>
        <p class="text-muted-foreground text-sm">
            Une modification du montant, du poste ou de l'imputation est tracée au journal d'activité.
        </p>
    </div>
</div>
{% include 'depense/_form.html.twig' with {button: 'Enregistrer'} %}
{% endblock %}
