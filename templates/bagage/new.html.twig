{% extends 'base.html.twig' %}

{% block title %}Nouveau bagage{% endblock %}

{% block body %}
<div class="flex items-center gap-3 mb-4">
    <a href="{{ path('bagage.index') }}" class="btn-icon">
        <svg class="h-5 w-5" aria-hidden="true"><use href="{{ asset('sprite.svg') }}#chevron-left"></use></svg>
    </a>
    <div>
        <h1 class="text-3xl font-light tracking-[-0.55px] leading-[1.2]">Enregistrer un bagage</h1>
        {% include 'partials/liens_rapides.html.twig' %}
    </div>
</div>
{% include 'bagage/_form.html.twig' with { button: 'Enregistrer', bagage: null, tarifbagages: tarifbagages } %}
{% endblock %}