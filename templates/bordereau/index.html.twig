{% extends 'base.html.twig' %}

{% block title %}Bordereaux{% endblock %}

{#
    BILAN DE CAISSE D'UNE GARE, pas un moteur de recherche.

    L'écran précédent n'affichait rien tant qu'on n'avait pas choisi une LIGNE, portait sur le mois
    en cours et ne montrait aucun montant — alors que le bordereau de gare est ce que le chef de gare
    édite en fin de JOURNÉE pour arrêter sa caisse. La page s'ouvre donc déjà remplie sur « ma gare,
    aujourd'hui » ; la ligne n'est plus qu'un filtre d'appoint.
#}

{% block body %}

{% set jour = debut == fin %}

{# ── En-tête ─────────────────────────────────────────────────────── #}
<div class="mb-6 flex items-start justify-between gap-4 max-lg:flex-col">
    <div class="flex items-start gap-3.5">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400">
            <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 3.75h6M9 8.25h6M5.25 5.25h13.5A1.5 1.5 0 0 1 20.25 6.75v12.75A1.5 1.5 0 0 1 18.75 21H5.25a1.5 1.5 0 0 1-1.5-1.5V6.75a1.5 1.5 0 0 1 1.5-1.5Z"/></svg>
        </div>
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-600 mb-1">Exploitation</p>
            <h1 class="text-4xl font-light tracking-[-0.55px] leading-[1.1]">Bordereaux</h1>
            <p class="text-muted-foreground mt-2 text-sm">
                {% if userGareLibelle %}
                    Départs de <span class="font-medium text-foreground">{{ userGareLibelle }}</span>
                {% elseif gareId %}
                    Départs de la gare sélectionnée
                {% else %}
                    Choisissez une gare pour arrêter sa caisse
                {% endif %}
                {% if jour %}
                    · {{ debut|date('d/m/Y') }}{% if estAujourdhui %} <span class="text-blue-600 font-medium">(aujourd'hui)</span>{% endif %}
                {% else %}
                    · du {{ debut|date('d/m/Y') }} au {{ fin|date('d/m/Y') }}
                {% endif %}
            </p>
        </div>
    </div>

    {# Raccourcis de jour : le geste le plus fréquent est « hier » (caisse de la veille) ou « aujourd'hui ». #}
    <div class="flex items-center gap-1.5 shrink-0 max-lg:w-full">
        {% set raccourcis = {
            'Hier': 'yesterday'|date('Y-m-d'),
            "Aujourd'hui": 'now'|date('Y-m-d'),
            'Demain': 'tomorrow'|date('Y-m-d')
        } %}
        {% for libelle, valeur in raccourcis %}
        <a href="{{ path('bordereau.index', {gare: gareId, ligne: ligneId, debut: valeur, fin: valeur}) }}"
           class="rounded-lg border px-3 py-1.5 text-xs font-medium transition max-lg:flex-1 max-lg:text-center
                  {{ (debut == valeur and fin == valeur) ? 'border-blue-600 bg-blue-600 text-white' : 'hover:bg-muted' }}">
            {{ libelle }}
        </a>
        {% endfor %}
    </div>
</div>

{# ── Totaux de la période ────────────────────────────────────────── #}
{# Affichés seulement s'ils sont RÉELS : au-delà du seuil de chargement, un total partiel serait un
   chiffre faux sur un écran de caisse. #}
{% if bordereauxCharges and voyages is not empty %}
<div class="mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
    <div class="card p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">Recette</p>
        <p class="mt-1 text-2xl font-light tabular-nums">{{ totaux.recette|number_format(0, ',', ' ') }} <span class="text-sm text-muted-foreground">FCFA</span></p>
    </div>
    <div class="card p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">Billets</p>
        <p class="mt-1 text-2xl font-light tabular-nums">{{ totaux.billets }}</p>
    </div>
    <div class="card p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">Bagages</p>
        <p class="mt-1 text-2xl font-light tabular-nums">{{ totaux.bagages }}</p>
    </div>
    <div class="card p-4">
        <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">Courriers</p>
        <p class="mt-1 text-2xl font-light tabular-nums">{{ totaux.courriers }}</p>
    </div>
</div>
{% endif %}

{# ── Filtres (repliés par défaut : la vue par défaut se suffit) ──── #}
{% set aFiltre = ligneId or not jour %}
<details class="card mb-6 overflow-hidden p-0" {{ aFiltre ? 'open' : '' }}>
    <summary class="flex cursor-pointer list-none items-center gap-2 border-b bg-muted/30 px-5 py-3">
        <svg class="size-4 text-muted-foreground" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z"/></svg>
        <span class="text-sm font-medium">Affiner</span>
        {% if aFiltre %}
        <span class="rounded-full bg-blue-100 px-2 py-0.5 text-[10px] font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-300">actif</span>
        <a href="{{ path('bordereau.index') }}" class="ml-auto text-xs font-medium text-muted-foreground hover:text-foreground transition">Réinitialiser</a>
        {% endif %}
    </summary>

    <form method="get" action="{{ path('bordereau.index') }}" class="p-5">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
            {# Gare — forcée pour un agent, choisie par un admin/central #}
            <div class="field">
                <label for="f-gare" class="label">Gare d'émission</label>
                {% if userGareId %}
                    <div id="f-gare" class="input flex items-center gap-1.5 cursor-not-allowed bg-muted/50 text-muted-foreground">
                        <span class="truncate">{{ userGareLibelle }}</span>
                        <span class="shrink-0 rounded bg-background/70 px-1.5 py-0.5 text-[10px] font-medium">votre gare</span>
                    </div>
                    <p class="field-description">Vous arrêtez la caisse de votre gare.</p>
                {% else %}
                    <select id="f-gare" name="gare" class="input">
                        <option value="">Choisir une gare…</option>
                        {% for g in gares %}
                        <option value="{{ g.id }}" {{ gareId == g.id ? 'selected' : '' }}>{{ g.libelle }} — {{ g.ville }}</option>
                        {% endfor %}
                    </select>
                    <p class="field-description">Requise pour afficher les recettes.</p>
                {% endif %}
            </div>

            {# Ligne — FACULTATIVE désormais #}
            <div class="field">
                <label for="f-ligne" class="label">Ligne</label>
                <select id="f-ligne"
                        name="ligne"
                        data-remote-select="lignes"
                        placeholder="Toutes les lignes…"
                        {% if ligneId %}data-value="{{ ligneId }}" data-label="{{ selectedLigneLabel }}"{% endif %}></select>
                <p class="field-description">Facultatif : pour n'garder qu'une ligne.</p>
            </div>

            {# Période #}
            <div class="field md:col-span-2">
                <label for="f-debut" class="label">Période de départ</label>
                <div class="input-range">
                    <input type="date" id="f-debut" name="debut" value="{{ debut }}" max="{{ fin }}" aria-label="Date de début" class="input" />
                    <span class="input-range-separator" aria-hidden="true">→</span>
                    <input type="date" name="fin" value="{{ fin }}" min="{{ debut }}" aria-label="Date de fin" class="input" />
                </div>
                <p class="field-description">Par défaut : la journée en cours.</p>
            </div>
        </div>

        <div class="mt-5 flex justify-end">
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 px-5 py-2 text-sm font-medium text-white hover:bg-blue-700 transition max-sm:w-full max-sm:justify-center">
                Appliquer
            </button>
        </div>
    </form>
</details>

{# ── Départs ─────────────────────────────────────────────────────── #}
{% if not gareId %}
    <div class="card p-10 text-center">
        <p class="text-sm text-muted-foreground">Choisissez une gare pour afficher ses départs et sa recette.</p>
    </div>

{% elseif voyages is empty %}
    <div class="card p-10 text-center">
        <p class="text-sm font-medium">Aucun départ sur cette période.</p>
        <p class="mt-1 text-sm text-muted-foreground">
            {% if jour %}Rien n'est programmé au départ de cette gare ce jour-là.{% else %}Élargissez la période ou retirez le filtre de ligne.{% endif %}
        </p>
    </div>

{% else %}
    {% if not bordereauxCharges %}
    <div class="mb-4 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300">
        <svg class="mt-0.5 size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>Trop de départs sur cette période pour en calculer les recettes ({{ voyages|length }}). Resserrez la période — un bilan de caisse se fait à la journée.</span>
    </div>
    {% endif %}

    <div class="space-y-3">
        {% for v in voyages %}
        {% set b = v.bordereau is defined ? v.bordereau : null %}
        {% set termine = v.datearriveereelle is not null %}
        {% set parti = v.datedepartreelle is not null %}

        <div class="card overflow-hidden">
            {# ── Bandeau du voyage ── #}
            <div class="flex items-center gap-4 px-5 py-4 max-md:flex-col max-md:items-start max-md:gap-3">
                {# Heure : l'information qu'on cherche en premier dans une journée de départs #}
                <div class="w-16 shrink-0 max-md:w-full">
                    <p class="text-2xl font-light tabular-nums leading-none">{{ v.datedepartprevue|date('H:i') }}</p>
                    {% if not jour %}<p class="mt-1 text-[11px] text-muted-foreground tabular-nums">{{ v.datedepartprevue|date('d/m') }}</p>{% endif %}
                </div>

                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-medium">{{ v.provenance }} → {{ v.destination }}</span>
                        <span class="rounded px-1.5 py-0.5 text-[10px] font-medium
                            {{ termine
                                ? 'bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300'
                                : (parti ? 'bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300' : 'bg-muted text-muted-foreground') }}">
                            {{ termine ? 'Clôturé' : (parti ? 'En route' : 'À quai') }}
                        </span>
                    </div>
                    <p class="mt-0.5 font-mono text-xs text-muted-foreground">{{ v.codevoyage }}</p>
                </div>

                {# Chiffres de LA gare sur ce voyage #}
                {% if b %}
                <div class="flex items-center gap-6 shrink-0 max-md:w-full max-md:justify-between">
                    <div class="text-right max-md:text-left">
                        <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Billets</p>
                        <p class="tabular-nums">{{ b.nbtickets }}</p>
                    </div>
                    <div class="text-right max-md:text-left">
                        <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Bagages</p>
                        <p class="tabular-nums">{{ b.nbbagages }}</p>
                    </div>
                    <div class="text-right max-md:text-left">
                        <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Courriers</p>
                        <p class="tabular-nums">{{ b.nbcourriers }}</p>
                    </div>
                    <div class="text-right max-md:text-left">
                        <p class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">Recette</p>
                        <p class="font-medium tabular-nums">{{ b.recette|number_format(0, ',', ' ') }} <span class="text-xs font-normal text-muted-foreground">F</span></p>
                    </div>
                </div>
                {% else %}
                <div class="shrink-0 text-xs text-muted-foreground max-md:w-full">{{ v.ticketsCount ?? 0 }} billet(s) sur le voyage</div>
                {% endif %}

                {# Impression : accessible sans rien déplier #}
                <div class="flex items-center gap-2 shrink-0 max-md:w-full">
                    <a href="{{ path('bordereau.print', {voyageId: v.id, gareId: gareId}) }}" data-imprimer
                       class="inline-flex items-center gap-1 rounded-md border px-2.5 py-1.5 text-xs font-medium hover:bg-muted transition max-md:flex-1 max-md:justify-center">
                        <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0l.229 2.523a1.125 1.125 0 01-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0021 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 00-1.913-.247M6.34 18H5.25A2.25 2.25 0 013 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 011.913-.247m10.5 0a48.536 48.536 0 00-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5zm-3 0h.008v.008H15V10.5z" /></svg>
                        Gare
                    </a>
                    {% if is_granted('VOYAGE_VOIR') %}
                    <a href="{{ path('bordereau.chauffeur', {voyageId: v.id}) }}" data-imprimer
                       class="inline-flex items-center gap-1 rounded-md border px-2.5 py-1.5 text-xs font-medium hover:bg-muted transition max-md:flex-1 max-md:justify-center">
                        <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
                        Chauffeur
                    </a>
                    {% endif %}
                </div>
            </div>

            {# ── Détail dépliable : ce que le PDF contiendra ── #}
            {% if b %}
            <details class="border-t">
                <summary class="flex cursor-pointer list-none items-center gap-2 px-5 py-2.5 text-xs font-medium text-muted-foreground hover:bg-muted/40 transition">
                    <svg class="size-3.5 transition-transform [details[open]_&]:rotate-90" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                    Voir le détail avant impression
                    <span class="ml-auto tabular-nums">
                        {{ b.placesoccupeesdepart }}/{{ b.voyage.placestotal }} places au départ · {{ b.placesrestantes }} restantes
                    </span>
                </summary>

                <div class="border-t bg-muted/20 px-5 py-4">
                    {# Horaires réels à CETTE gare : ce qui permet de justifier un retard sur la caisse.
                       Le bordereau les livre DÉJÀ FORMATÉS ('H:i' côté BordereauProvider) : y appliquer
                       un filtre 'date' ferait échouer le rendu sur une chaîne non parsable. #}
                    {% if b.gare.heurePrevue or b.gare.arriveeReelle or b.gare.departReelle %}
                    <div class="mb-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs">
                        {% if b.gare.heurePrevue %}<span class="text-muted-foreground">Prévu <span class="font-medium text-foreground tabular-nums">{{ b.gare.heurePrevue }}</span></span>{% endif %}
                        {% if b.gare.arriveeReelle %}<span class="text-muted-foreground">Arrivée <span class="font-medium text-foreground tabular-nums">{{ b.gare.arriveeReelle }}</span></span>{% endif %}
                        {% if b.gare.departReelle %}<span class="text-muted-foreground">Départ <span class="font-medium text-foreground tabular-nums">{{ b.gare.departReelle }}</span></span>{% endif %}
                        {% if b.gare.retardMinutes is not null %}
                        <span class="rounded px-1.5 py-0.5 text-[11px] font-medium tabular-nums
                            {{ b.gare.retardMinutes > 0 ? 'bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300' : 'bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300' }}">
                            {{ b.gare.retardMinutes > 0 ? '+' ~ b.gare.retardMinutes ~ ' min' : b.gare.retardMinutes ~ ' min' }}
                        </span>
                        {% endif %}
                        {% if b.gare.tempsArretMinutes is not null %}<span class="text-muted-foreground">À quai <span class="font-medium text-foreground tabular-nums">{{ b.gare.tempsArretMinutes }} min</span></span>{% endif %}
                    </div>
                    {% endif %}

                    {# Répartition par destination — le même récapitulatif que le PDF, et c'est le
                       point : « voir le détail avant impression » ne doit rien réserver au papier.
                       En puces plutôt qu'en tableau : deux ou trois lignes se lisent d'un coup d'œil,
                       et le tableau des passagers suit juste en dessous. #}
                    {% set destinations = b.destinations ?? [] %}
                    {% if destinations is not empty %}
                    <div class="mb-4 flex flex-wrap items-center gap-2">
                        {% for d in destinations %}
                        <span class="inline-flex items-center gap-1.5 rounded-md border bg-background px-2.5 py-1 text-xs">
                            <span class="font-medium">{{ d.depart }} → {{ d.destination }}</span>
                            <span class="rounded bg-muted px-1.5 py-0.5 font-medium tabular-nums">{{ d.nbtickets }}</span>
                        </span>
                        {% endfor %}
                    </div>
                    {% endif %}

                    {% if b.passagers is empty %}
                        <p class="text-sm text-muted-foreground">Aucun billet émis depuis cette gare sur ce voyage.</p>
                    {% else %}
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="text-left text-xs text-muted-foreground">
                                        <th class="pb-2 pr-4 font-medium">Siège</th>
                                        <th class="pb-2 pr-4 font-medium">Billet</th>
                                        <th class="pb-2 pr-4 font-medium">Client</th>
                                        <th class="pb-2 pr-4 font-medium">Contact</th>
                                        <th class="pb-2 pr-4 font-medium">Émis à</th>
                                        <th class="pb-2 text-right font-medium">Prix</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for p in b.passagers %}
                                    <tr class="border-t border-border/50">
                                        <td class="py-2 pr-4 tabular-nums font-medium">{{ p.siegenumero }}</td>
                                        <td class="py-2 pr-4 font-mono text-xs text-muted-foreground">{{ p.codeticket }}</td>
                                        <td class="py-2 pr-4">{{ p.nomclient ?: '—' }}</td>
                                        <td class="py-2 pr-4 text-muted-foreground">{{ p.contactclient ?: '—' }}</td>
                                        {# 'createdat' arrive en 'd/m/Y H:i' : sur un bordereau de journée
                                           seule l'heure d'encaissement importe. #}
                                        <td class="py-2 pr-4 text-muted-foreground tabular-nums">{{ p.createdat|split(' ')|last }}</td>
                                        <td class="py-2 text-right tabular-nums">{{ p.prix|number_format(0, ',', ' ') }}</td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                                <tfoot>
                                    <tr class="border-t">
                                        <td colspan="5" class="pt-2 text-right text-xs font-medium text-muted-foreground">Total encaissé</td>
                                        <td class="pt-2 text-right font-medium tabular-nums">{{ b.recette|number_format(0, ',', ' ') }} F</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </details>
            {% endif %}
        </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
