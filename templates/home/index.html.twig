{% extends 'base.html.twig' %}

{% block title %}{{ mode == 'gare' ? 'Ma gare' : 'Tableau de bord' }}{% endblock %}

{% block body %}
{# Tableau de bord UNIQUE, conditionné selon le profil (cf. HomeController::index) :
    - 'gare'       : agent rattaché à une gare -> vue opérationnelle de SA gare
    - 'entreprise' : admin d'entreprise ou utilisateur central sans gare -> vue globale #}
{% if mode == 'gare' %}
    {% include 'home/_gare.html.twig' %}
{% else %}
    {% include 'home/_entreprise.html.twig' %}
{% endif %}
{% endblock %}
