<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %} | Transport</title>
        {# AVANT la feuille de style : la classe doit être posée quand le CSS s'applique, pas après.
           C'est le SEUL script de thème : l'ancien, en ligne juste au-dessus, faisait doublon (supprimé). #}
        {{ include('partials/theme-preload.html.twig') }}
        {{ include('partials/pwa.html.twig') }}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <style>
            body {
                overflow: scroll !important;
            }
        </style>
        <div class="mt-4">
            {% include 'partials/flash.html.twig' %}
            {% block body %}{% endblock %}
        </div>
    </body>
</html>